{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/hooks/agent-output-redirect.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/hooks/hook.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/hooks/hook.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/hooks/hook.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "INPUT=$(cat); python3 \"$CLAUDE_PLUGIN_ROOT/summarize.py\" >/dev/null 2>&1 || true; echo \"$INPUT\" | bash \"$CLAUDE_PLUGIN_ROOT/scripts/emit-interspect-evidence.sh\" 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
