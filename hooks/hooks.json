{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "timeout": 10,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/agent-output-redirect.sh"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh"
            ]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "timeout": 10,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh"
            ]
          },
          {
            "type": "command",
            "command": "INPUT=$(cat); echo \"$INPUT\" | bash \"$CLAUDE_PLUGIN_ROOT/scripts/emit-interspect-evidence.sh\" 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
